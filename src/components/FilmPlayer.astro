---
import Picture from './Picture.astro';
import Arrow from './Arrow.astro';
import { media } from '../data/projects';
const filmUrl='https://www.youtube.com/watch?v=VF31YJVjnY4';
---
<section class="case-film wrap" aria-labelledby="film-heading">
 <div class="section-heading"><h2 id="film-heading">Watch the documentary</h2><p>23 min · Ralph Lauren</p></div>
 <div class="film-player" data-film-player>
  <a class="film-poster" href={filmUrl} data-film-play aria-label="Play A Portrait of the American Dream: Oak Bluffs">
   <Picture src={media.ralph} alt="Interview scene from the documentary" />
   <span class="film-play-label"><span aria-hidden="true">▶</span> Play film</span>
  </a>
 </div>
 <div class="film-context"><p>Directed by Cole Brown. Ahren served as director of photography and camera operator for the interview segment produced by Coyote Ranch Films.</p><a class="text-link" href={filmUrl} target="_blank" rel="noopener noreferrer">Watch on YouTube<Arrow /><span class="sr-only">(opens in a new tab)</span></a></div>
</section>
<script>
 document.querySelectorAll<HTMLElement>('[data-film-player]').forEach(container=>{
  const link=container.querySelector<HTMLAnchorElement>('[data-film-play]');
  link?.addEventListener('click',event=>{
   if(event.ctrlKey||event.metaKey||event.shiftKey||event.altKey) return;
   event.preventDefault();
   const frame=document.createElement('iframe');
   frame.title='A Portrait of the American Dream: Oak Bluffs — Ralph Lauren';
   frame.src='https://www.youtube-nocookie.com/embed/VF31YJVjnY4?autoplay=1&playsinline=1&rel=0';
   frame.allow='autoplay; encrypted-media; picture-in-picture; fullscreen';
   frame.allowFullscreen=true;
   frame.referrerPolicy='strict-origin-when-cross-origin';
   container.replaceChildren(frame);
   frame.focus({ preventScroll: true });
   const bounds=container.getBoundingClientRect();
   const headerBottom=document.querySelector('.site-header')?.getBoundingClientRect().bottom ?? 0;
   if(bounds.top<headerBottom+16 || bounds.bottom>window.innerHeight-16) {
    container.scrollIntoView({ block: 'center', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
   }
  });
 });
</script>
<style>
 .case-film { --film-width: min(1100px, max(356px, calc((100svh - 260px) * 16 / 9))); padding-bottom: clamp(65px,8vw,130px); }
 .case-film > * { max-width: var(--film-width); margin-inline: auto; }
 .case-film .section-heading { align-items: center; gap: 16px 24px; margin-bottom: 22px; flex-wrap: wrap; }
 .case-film .section-heading h2 { font-size: clamp(26px,2.8vw,42px); line-height: 1.1; }
 .case-film .section-heading p { font-size: 13px; }
 .film-player { width: 100%; aspect-ratio: 16/9; min-height: 200px; background: #080808; position: relative; }
 .film-poster { display: block; width: 100%; height: 100%; position: absolute; inset: 0; }
 .film-poster :global(img) { height: 100%; object-fit: contain; }
 .film-play-label { position: absolute; left: 24px; bottom: 24px; display: flex; align-items: center; gap: 18px; padding: 17px 24px; min-height: 52px; color: var(--bg); background: var(--text); font-size: 14px; transition: background .2s, color .2s; }
 .film-poster:is(:hover,:focus-visible) .film-play-label { background: var(--red); color: white; }
 .film-player :global(iframe) { display: block; width: 100%; height: 100%; position: absolute; inset: 0; border: 0; }
 .film-context { display: flex; justify-content: space-between; align-items: start; gap: 24px; padding-top: 16px; }
 .film-context p { max-width: 70ch; font-size: 13px; color: var(--muted); line-height: 1.6; }
 .film-context a { flex-shrink: 0; }
 @media(max-height:560px) and (min-width:600px) {
  .case-film { --film-width: max(356px, calc((100svh - 180px) * 16 / 9)); }
  .case-film .section-heading { gap: 6px; margin-bottom: 12px; }
  .case-film .section-heading h2 { font-size: 26px; }
 }
 @media(max-width:540px) { .case-film .section-heading,.film-context { display: block; } .case-film .section-heading p { margin-top: 10px; } .film-context a { margin-top: 12px; } .film-play-label { bottom: 14px; left: 14px; padding: 12px 18px; min-height: 44px; } }
 @media(prefers-reduced-motion:reduce) { .film-play-label { transition: none; } }
</style>
