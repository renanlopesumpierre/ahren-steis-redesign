---
import Arrow from '../../components/Arrow.astro';
import Site from '../../layouts/Site.astro';
import Picture from '../../components/Picture.astro';
import NextProject from '../../components/NextProject.astro';
import Gallery from '../../components/Gallery.astro';
import FilmPlayer from '../../components/FilmPlayer.astro';
import { projects } from '../../data/projects';
export function getStaticPaths(){return projects.map((project,index)=>({params:{slug:project.slug},props:{project,next:projects[(index+1)%projects.length]}}));}
const {project:p,next}=Astro.props;
---
<Site title={p.shortTitle} description={p.intro}>
 <section class="case-intro wrap"><a class="text-link" href="/work/">← Selected work</a><div class="case-title-row"><h1 class:list={[{'long-title':p.title.length>30}]}>{p.title}</h1><p>{p.purpose}<br/>{p.role}</p></div></section>
 <div style={`view-transition-name:project-${p.slug};--cover-ratio:${p.cover.width} / ${p.cover.height}`} class:list={['case-cover',{'portrait-cover':p.slug==='kentucky-ballistics'}]}>{p.slug==='kentucky-ballistics'?<div class="hero-triptych">{p.frames.map(f=><figure><Picture src={f.image} alt={f.alt} eager /></figure>)}</div>:<Picture src={p.cover} alt={p.alt} eager position={p.position} />}</div>
 <section class="case-overview wrap section-space"><div class="case-thesis"><h2>{p.headline || p.intro}</h2>{p.headline && <p>{p.intro}</p>}</div><div><p class="case-context">{p.context}</p>{p.sections.map(s=><article data-reveal><h3>{s.title}</h3><p>{s.text}</p></article>)}</div></section>
 {p.slug==='we-the-free'&&<aside class="production-principle wrap"><p>One production should be able to do more than one job.</p><div><p>Planning the show, its promotion and its supporting assets as one production.</p><a class="text-link" href="/insights/every-asset-needs-a-job/">Explore the production system <Arrow /></a></div></aside>}
 {p.slug==='ralph-lauren'&&<FilmPlayer />}
 <section class="wrap case-gallery"><div class="section-heading"><h2>Production frames</h2><p>Select an image for a closer look.</p></div><Gallery id={p.slug} frames={p.frames} portrait={p.slug==='kentucky-ballistics'} /></section>
 <section class="credits wrap section-space"><h2>Project credits</h2><dl>{p.credits.map(c=><div><dt>{c.label}</dt><dd>{c.value}</dd></div>)}</dl></section>
 <NextProject project={next} />
</Site>
